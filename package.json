{
  "name": "my-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @my-app/api db:generate",
    "db:migrate": "pnpm --filter @my-app/api db:migrate",
    "db:seed": "pnpm --filter @my-app/api db:seed",
    "clean": "turbo clean",
    "setup": "node scripts/setup.js",
    "rx:dryrun": "node --env-file=.env scripts/rx-dryrun.mjs"
  },
  "devDependencies": {
    "turbo": "^2.10.4"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.6",
      "fast-uri": ">=3.1.2 <4",
      "shell-quote": ">=1.8.4",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4"
    }
  }
}
