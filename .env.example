# ═══════════════════════════════════════════════════════════════
# Environment Variables — Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# ── App ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_app

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
MFA_ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@myapp.com

# ── File Storage (GCS) ──
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_KEY_FILE=

# ── Seazona API ──
SEAZONA_API_KEY=
SEAZONA_SECRET=
SEAZONA_BASE_URL=https://diamondapi.labzona.net/
# Lab-staff Seazona user id that catalog-order pushes (createOrder) are attributed
# to. Leave UNSET until the lab confirms the staff id — when unset, guest catalog
# orders are recorded locally but NOT pushed to Seazona. Never guess this value.
SEAZONA_ORDER_USER_ID=

# ── Authorize.net (server-side, never expose the transaction key) ──
AUTHORIZE_NET_API_LOGIN=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_ENV=sandbox

# ── Authorize.net (Vite — exposed to the client for Accept.js tokenization) ──
# API Login ID is duplicated here because Accept.js requires it on the client.
# The Public Client Key is issued separately in the Authorize.net merchant
# interface (Account → Security Settings → Manage Public Client Key). Never
# expose the transaction key to the client.
VITE_AUTHORIZE_NET_API_LOGIN=
VITE_AUTHORIZE_NET_CLIENT_KEY=

# ── Admin ──
ADMIN_NOTIFICATION_EMAIL=
