# ═══════════════════════════════════════════════════════════════
# Environment Variables — Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# ── App ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
# Production CORS allow-list (comma-separated, exact origins incl. scheme).
# REQUIRED in production — set to the real deployed frontend origin(s), e.g.
# CORS_ORIGINS=https://app.diamond-labs.com
# When unset, the code falls back to project.config.js (a placeholder domain).
# Localhost is always allowed in dev regardless of this value.
CORS_ORIGINS=

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_app

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# PHI at-rest encryption (AES-256-GCM) for rx_cases PHI columns + mfaSecret.
# 32-byte key, preferably 64-char hex. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LOSING THIS KEY = UNRECOVERABLE PHI. Store in GCP Secret Manager and back it up.
PHI_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@myapp.com

# ── File Storage (GCS) ──
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_KEY_FILE=

# ── Seazona API ──
SEAZONA_API_KEY=
SEAZONA_SECRET=
SEAZONA_BASE_URL=https://diamondapi.labzona.net/

# ── Lab orders ──
# First lab order number. Allocation is max(existing + 1, start), so raising it
# later never reuses a number. Piece 5 sets this to Seazona's last order number + 1.
LAB_ORDER_NUMBER_START=100000

# ── Shipping (piece 4) ──
# The lab's identity. The address is the ship-from on every label; UPS and
# FedEx stay disabled until LINE1, CITY, STATE, ZIP and PHONE are all set.
LAB_NAME=Diamond Orthotic Laboratory
LAB_PHONE=
LAB_ADDRESS_LINE1=
LAB_ADDRESS_LINE2=
LAB_CITY=
LAB_STATE=
LAB_ZIP=
# Carrier credentials (Secret Manager in prod). Any value unset = that carrier is disabled.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
# sandbox | production (staging is always sandbox)
CARRIER_ENV=sandbox
# image (UPS GIF / FedEx PNG via the browser) | zpl (Zebra thermal files)
LABEL_FORMAT=image
# none | carrier_cost | flat — what a shipment adds to the draft invoice
SHIPPING_CHARGE_POLICY=none
SHIPPING_FLAT_CENTS=0
SHIPPED_EMAIL_ENABLED=true

# ── Authorize.net (server-side, never expose the transaction key) ──
AUTHORIZE_NET_API_LOGIN=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_ENV=sandbox

# ── Authorize.net (Vite — exposed to the client for Accept.js tokenization) ──
# API Login ID is duplicated here because Accept.js requires it on the client.
# The Public Client Key is issued separately in the Authorize.net merchant
# interface (Account → Security Settings → Manage Public Client Key). Never
# expose the transaction key to the client.
VITE_AUTHORIZE_NET_API_LOGIN=
VITE_AUTHORIZE_NET_CLIENT_KEY=

# ── Maintenance ──
# Cutover freeze: "true" pauses doctor and staff payments (see the cutover runbook).
# Only true/false are accepted; anything else fails boot.
PAYMENTS_PAUSED=false

# ── AutoPay ──
# false = compute and record, charge nothing. Flip only after reviewing a dry run.
AUTOPAY_LIVE_RUN=false
AUTOPAY_MIN_AMOUNT=200
AUTOPAY_TIMEZONE=America/Chicago
AUTOPAY_MAX_FAILURES=3
# Shared secret Cloud Scheduler presents to the HTTP job trigger.
JOBS_TRIGGER_SECRET=

# ── Admin ──
# One address, or several separated by commas (every Rx submission waits for admin review).
ADMIN_NOTIFICATION_EMAIL=

# ── Piece 5 import tools (operator machine only; never set on Cloud Run) ──
# Each must point at the named database (src/import/targets.js checks the name). All three
# share one cloud-sql-proxy on port 6001 (one Cloud SQL instance; docs/import-operations.md).
# IMPORT_DATABASE_URL=postgresql://importer:...@127.0.0.1:6001/diamond_labs_import
# REHEARSAL_DATABASE_URL=postgresql://...@127.0.0.1:6001/diamond_labs_rehearsal
# PRODUCTION_DATABASE_URL=postgresql://...@127.0.0.1:6001/diamond_labs
